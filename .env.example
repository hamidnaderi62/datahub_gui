# Copy to .env for local Docker Compose use. Use new, unique values.
DJANGO_SECRET_KEY=replace-with-a-random-secret
API_SECRET_KEY=replace-with-a-different-random-secret
DJANGO_DEBUG=true
DJANGO_LANGUAGE_CODE=fa
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gui
API_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_NAME=datahub
DATABASE_USER=datahub
DATABASE_PASSWORD=replace-with-a-strong-password
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret-key
S3_REGION=us-east-1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@datahub.local

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
PIPELINE_AUTO_DISPATCH=false
PIPELINE_WORKER_CONCURRENCY=2
PIPELINE_RUN_STALE_AFTER_SECONDS=3600
PIPELINE_ANTIVIRUS_MODE=disabled
PIPELINE_ANTIVIRUS_TIMEOUT_SECONDS=300
PIPELINE_STRICT_FILE_TYPES=false
DIRECT_S3_UPLOADS=true
# Use the legacy Django chunk path temporarily when S3 browser CORS is not ready.
DIRECT_S3_UPLOAD_FALLBACK=true
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
EXTERNAL_IMPORT_HMAC_SECRET=replace-with-a-long-random-shared-secret
EXTERNAL_IMPORT_BUCKETS=datahub-quarantine
IMPORT_QUARANTINE_BUCKET=datahub-quarantine
KAGGLE_USERNAME=
KAGGLE_KEY=
